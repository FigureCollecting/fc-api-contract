{
  "name": "@figurecollecting/fc-api-contract",
  "version": "0.4.0",
  "description": "coordinator.v1: the CLIENT-facing wire contract served by fc-coordinator. CompareService (the spine read.v1 CompareResult carried verbatim), SyncService (SyncEvent {facet_key, version, op, payload} plus Delta/Push/Status), CatalogService (ProductCard reads) and ImportService (MFC export import). Generated TypeScript is committed and published, with the version and facet-key helpers, golden version and key vectors and payload JSON Schemas both sides test against.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FigureCollecting/fc-api-contract.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proto/coordinator/v1/compare.proto": "./proto/coordinator/v1/compare.proto",
    "./proto/coordinator/v1/sync.proto": "./proto/coordinator/v1/sync.proto",
    "./proto/coordinator/v1/catalog.proto": "./proto/coordinator/v1/catalog.proto",
    "./proto/coordinator/v1/import.proto": "./proto/coordinator/v1/import.proto",
    "./golden/version-vectors.json": "./golden/version-vectors.json",
    "./golden/key-vectors.json": "./golden/key-vectors.json",
    "./golden/import-vectors.json": "./golden/import-vectors.json",
    "./golden/display-vectors.json": "./golden/display-vectors.json",
    "./schemas/*": "./schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "proto",
    "dist",
    "golden",
    "schemas",
    "buf.yaml",
    "buf.gen.yaml",
    "README.md"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "generate": "buf generate",
    "lint": "buf lint",
    "breaking": "bash scripts/buf-breaking.sh",
    "schema-growth": "node scripts/schema-growth.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run breaking && npm run schema-growth && npm run build && npm run test:ci",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.15.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protobuf": "^2.15.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
